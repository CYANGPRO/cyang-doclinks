# Public application URL for the CAT app deployment.
LOCAL801_APP_URL=https://cat.cyang.io

# Auth callback URL for the separate CAT authentication environment.
NEXTAUTH_URL=https://cat.cyang.io

# Separate CAT PostgreSQL database. Do not point this at DocLinks DATABASE_URL.
LOCAL801_DATABASE_URL=

# Separate CAT private object-storage environment. Do not point this at the DocLinks R2 bucket.
LOCAL801_R2_ACCOUNT_ID=local801-account-id
LOCAL801_R2_ENDPOINT=https://local801-account-id.r2.cloudflarestorage.com
LOCAL801_R2_BUCKET=local801-engage-private
LOCAL801_R2_ACCESS_KEY_ID=
LOCAL801_R2_SECRET_ACCESS_KEY=

# Separate CAT object-encryption keys. Placeholder only; never commit a generated value.
# Exact format: a one-line JSON object mapping versions to canonical base64-encoded 32-byte keys.
LOCAL801_ENCRYPTION_MASTER_KEYS={"v1":"<base64-encoded-32-byte-key>"}
LOCAL801_ACTIVE_ENCRYPTION_KEY_VERSION=v1

# Stage 14B database-PII protection uses TWO additional, independent keyrings.
# Generate all values independently; never reuse object-encryption, PII-encryption, or blind-index key material.
# Keep old versions during rotation until every protected value/index has been migrated and verified.
LOCAL801_PII_ENCRYPTION_MASTER_KEYS={"v1":"<different-base64-encoded-32-byte-key>"}
LOCAL801_PII_ACTIVE_ENCRYPTION_KEY_VERSION=v1
LOCAL801_PII_BLIND_INDEX_KEYS={"v1":"<another-different-base64-encoded-32-byte-key>"}
LOCAL801_PII_ACTIVE_BLIND_INDEX_KEY_VERSION=v1

# Stage 14B protected-PII transition gates. Every maintenance/write switch defaults off.
# DUAL_WRITE may be enabled only during guarded synthetic Preview acceptance after the scaffolding migrations.
# BACKFILL may be enabled only for the explicit one-shot protected backfill command.
# PROTECTED_READ_PREVIEW is only the pre-cutover synthetic read-adapter acceptance switch.
# DATABASE_PII_PROTECTION_ENABLED becomes 1 only after the guarded database cutover marks write_mode='protected'.
LOCAL801_PII_DUAL_WRITE_ENABLED=0
LOCAL801_PII_BACKFILL_ENABLED=0
LOCAL801_PII_PROTECTED_READ_PREVIEW_ENABLED=0
LOCAL801_DATABASE_PII_PROTECTION_ENABLED=0

# Guarded Stage 14B maintenance commands. Never leave these enabled during normal application operation.
LOCAL801_PII_CUTOVER_ENABLED=0
LOCAL801_PII_KEY_ROTATION_ENABLED=0
LOCAL801_PII_ROTATION_WRITES_QUIESCED=0
# Rotation source versions/actor/confirmation are supplied only for an explicit maintenance run.
# LOCAL801_PII_ROTATION_ORGANIZATION_SLUG=
# LOCAL801_PII_ROTATION_ACTOR_USER_ID=
# LOCAL801_PII_ROTATION_FROM_ENCRYPTION_KEY_VERSION=
# LOCAL801_PII_ROTATION_FROM_BLIND_INDEX_KEY_VERSION=
# LOCAL801_PII_ROTATION_CONFIRM=

# Local, one-command seed safety switch. Do not persist as 1 in Vercel.
LOCAL801_ALLOW_SYNTHETIC_SEED=0

# Separate CAT auth secret. Do not reuse DocLinks NEXTAUTH_SECRET.
NEXTAUTH_SECRET=

# Production authentication. Keep disabled in synthetic Preview.
# Production uses a trusted OIDC identity provider for identity + MFA assurance, while the
# Local 801 database remains authoritative for active-user status, role, and session revocation.
LOCAL801_PRODUCTION_AUTH_ENABLED=0
LOCAL801_PERFORMANCE_TIMING_ENABLED=0
LOCAL801_SLOW_QUERY_MS=150
LOCAL801_ORGANIZATION_SLUG=local801
LOCAL801_OIDC_PROVIDER_ID=local801-oidc
LOCAL801_OIDC_PROVIDER_NAME=Organization sign-in
LOCAL801_OIDC_WELL_KNOWN=https://idp.example.test/.well-known/openid-configuration
LOCAL801_OIDC_CLIENT_ID=
LOCAL801_OIDC_CLIENT_SECRET=
# Microsoft Entra tenant ID used with the immutable tid + oid account binding.
LOCAL801_OIDC_TENANT_ID=
LOCAL801_OIDC_BOOTSTRAP_OBJECT_ID=
# Non-directory providers must return email_verified=true, verified_primary_email, or the
# configured authoritative local801_email claim. Entra users are selected by verified tid + oid.
# The configured
# bootstrap object ID is the sole exception and binds only the recorded initial system owner.
# Every sign-in must also return this configured assurance claim/value.
# Use amr for providers that emit an authentication-method array such as ["pwd","mfa"],
# or acr when the provider exposes a single assurance-context value.
LOCAL801_OIDC_MFA_CLAIM=amr
LOCAL801_OIDC_MFA_VALUE=mfa

# One-step CAT user onboarding through Microsoft Graph. When enabled, adding a user in
# Team & Access creates the Entra B2B guest, assigns the enterprise application, and asks
# Microsoft to send the customized invitation email. The existing confidential OIDC app
# must have admin-consented application permissions User.Invite.All,
# AppRoleAssignment.ReadWrite.All, and Application.Read.All.
LOCAL801_ENTRA_USER_PROVISIONING_ENABLED=0
# Object ID of the Enterprise Application service principal (not the Application/client ID).
LOCAL801_ENTRA_ENTERPRISE_APP_OBJECT_ID=
# Use the all-zero default role when the enterprise application exposes no app roles.
LOCAL801_ENTRA_ENTERPRISE_APP_ROLE_ID=00000000-0000-0000-0000-000000000000
# Monitored address included in every invitation for access, MFA, and role support.
LOCAL801_ACCESS_SUPPORT_EMAIL=owner@example.test

# Stage 14 production launch interlock. Every value below intentionally defaults to locked.
# Do not set LOCAL801_PRODUCTION_LAUNCH_ENABLED=1 until all production-readiness work is complete.
# Database PII protection remains 0 until the Stage 14B protected-schema/read/search/import/report acceptance gate passes.
# BACKUP_RESTORE_VERIFIED must represent an actual restore exercise, not merely backup enablement.
# SECURITY_REVIEW_APPROVED requires the final security review; store only a non-secret review/change reference ID.
LOCAL801_PRODUCTION_LAUNCH_ENABLED=0
LOCAL801_DISTRIBUTED_RATE_LIMIT_ENABLED=0
LOCAL801_RATE_LIMIT_IP_HASH_KEY=
LOCAL801_RATE_LIMIT_AUTHENTICATION_MAX=10
LOCAL801_RATE_LIMIT_AUTHENTICATION_WINDOW_SECONDS=300
LOCAL801_RATE_LIMIT_UPLOAD_MAX=10
LOCAL801_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
LOCAL801_RATE_LIMIT_IMPORT_MAX=20
LOCAL801_RATE_LIMIT_IMPORT_WINDOW_SECONDS=600
LOCAL801_RATE_LIMIT_DOWNLOAD_EXPORT_MAX=60
LOCAL801_RATE_LIMIT_DOWNLOAD_EXPORT_WINDOW_SECONDS=60
LOCAL801_RATE_LIMIT_SEARCH_MAX=120
LOCAL801_RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
LOCAL801_RATE_LIMIT_ADMINISTRATIVE_MUTATION_MAX=30
LOCAL801_RATE_LIMIT_ADMINISTRATIVE_MUTATION_WINDOW_SECONDS=300
LOCAL801_BACKUP_RESTORE_VERIFIED=0
LOCAL801_SECURITY_REVIEW_APPROVED=0
LOCAL801_PRODUCTION_SECURITY_REVIEW_ID=

# Application metadata.
LOCAL801_APP_NAME=Local 801 Engage
LOCAL801_APP_SHORT_NAME=801 Engage
LOCAL801_THEME_COLOR=#244b45

# Access policy.
SIGNUP_ENABLED=0
MFA_ENFORCE_ALL=1
LOCAL801_CAT_SESSION_SECONDS=604800
LOCAL801_ADMIN_SESSION_SECONDS=43200
LOCAL801_REAUTH_WINDOW_SECONDS=900

# Import/export controls.
LOCAL801_IMPORT_MAX_BYTES=20971520
LOCAL801_IMPORT_MAX_ROWS=25000
LOCAL801_EXPORT_MAX_ROWS=5000
LOCAL801_SMALL_CELL_THRESHOLD=5
LOCAL801_SEARCH_RATE_LIMIT_PER_MINUTE=60
LOCAL801_IMPORT_RATE_LIMIT_PER_HOUR=10
LOCAL801_EXPORT_RATE_LIMIT_PER_HOUR=20
LOCAL801_DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
LOCAL801_MUTATION_RATE_LIMIT_PER_MINUTE=120

# PWA controls.
LOCAL801_PWA_ENABLED=1
LOCAL801_SERVICE_WORKER_CACHE_VERSION=local801-static-v1

# Preview auth is for private preview only. Disable in production.
LOCAL801_PREVIEW_AUTH_ENABLED=0

# Preview-only member email broadcast prototype. Production and production-launch
# runtimes always deny this feature. It accepts only synthetic example.test recipients
# and records simulated delivery events; no provider credential is used.
LOCAL801_EMAIL_BROADCAST_PREVIEW_ENABLED=0

# Explicit Preview-only gate for the first durable CSV worker. Production is always denied.
LOCAL801_DURABLE_IMPORTS_ENABLED=0
# Separate protected-only durable worker gate. Production launch requires this to be 1;
# the worker still remains locked behind the complete launch interlock and protected database state.
LOCAL801_PROTECTED_DURABLE_IMPORTS_ENABLED=0

# Authoritative-import master switch. Keep 0 during ordinary Preview and production operation.
# The legacy Stage 12 executor remains intrinsically non-production and additionally requires Preview auth.
# A future production protected import may set this to 1 only when DATABASE_PII_PROTECTION_ENABLED=1,
# dual-write/backfill are off, and BOTH protected preparation/execution gates below are explicitly 1.
LOCAL801_AUTHORITATIVE_IMPORT_EXECUTION_ENABLED=0
LOCAL801_PROTECTED_IMPORT_PREPARATION_ENABLED=0
LOCAL801_PROTECTED_IMPORT_EXECUTION_ENABLED=0

# Dedicated malware scanner. Production launch requires this to be 1 with the exact private HMAC client configuration.
# The HMAC secret must be exactly 64 lowercase hexadecimal characters; never commit a real value.
LOCAL801_MALWARE_SCANNER_ENABLED=0
LOCAL801_MALWARE_SCANNER_URL=https://scan.cyang.io
LOCAL801_MALWARE_SCANNER_CLIENT_ID=
LOCAL801_MALWARE_SCANNER_HMAC_SECRET_HEX=

# Push notification controls. Keep disabled until VAPID keys exist.
LOCAL801_PUSH_ENABLED=0
LOCAL801_VAPID_PUBLIC_KEY=disabled-until-generated
LOCAL801_VAPID_PRIVATE_KEY=disabled-until-generated
LOCAL801_VAPID_SUBJECT=mailto:owner@example.test

# Native mobile trust and generic delivery. These remain fail-closed until the
# owner-controlled attestation/push gateways and store signing identities exist.
LOCAL801_NATIVE_MOBILE_ENABLED=0
LOCAL801_MOBILE_ATTESTATION_GATEWAY_URL=https://attest.cyang.io
LOCAL801_MOBILE_ATTESTATION_HMAC_SECRET_HEX=
LOCAL801_MOBILE_PUSH_GATEWAY_URL=https://push.cyang.io
LOCAL801_MOBILE_PUSH_HMAC_SECRET_HEX=
LOCAL801_APPLE_TEAM_ID=
LOCAL801_ANDROID_CLOUD_PROJECT_NUMBER=
# Comma-separated SHA-256 fingerprints for the Google Play app-signing
# certificate (and any separately distributed production certificate).
LOCAL801_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
# Local/CI-only Android upload-key settings. Never put these in Vercel; the
# keystore file and passwords belong in the release workstation or CI vault.
LOCAL801_ANDROID_UPLOAD_KEYSTORE_PATH=
LOCAL801_ANDROID_UPLOAD_KEYSTORE_PASSWORD=
LOCAL801_ANDROID_UPLOAD_KEY_ALIAS=
LOCAL801_ANDROID_UPLOAD_KEY_PASSWORD=

# Reporting is implemented as authenticated custom web reports backed by Local 801 reporting views.
# No Power BI connection or Power BI runtime variables are part of this application architecture.

# Separate CAT monitoring project DSN.
LOCAL801_SENTRY_ENABLED=0
LOCAL801_SENTRY_DSN=
