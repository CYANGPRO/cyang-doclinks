LOCAL801_SCANNER_BIND_HOST=127.0.0.1
LOCAL801_SCANNER_PORT=8089
LOCAL801_SCANNER_ALLOWED_HOST=scan.cyang.io
LOCAL801_SCANNER_NONCE_STATE_PATH=/run/local801-cat-scanner/nonces.json
LOCAL801_SCANNER_CLIENT_ID=local801-production
LOCAL801_SCANNER_HMAC_SECRET_HEX=replace-with-64-lowercase-hex-characters
