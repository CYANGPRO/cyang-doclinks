# LOCAL801_SCANNER_PREVIEW_HMAC_SECRET_HEX=replace-with-a-different-64-lowercase-hex-key
LOCAL801_SCANNER_CLAMD_SOCKET=/run/clamav/clamd.ctl
LOCAL801_SCANNER_CLAMD_HOST=127.0.0.1
LOCAL801_SCANNER_CLAMD_PORT=3310
LOCAL801_SCANNER_MAX_BYTES=20971520
LOCAL801_SCANNER_TIMESTAMP_SKEW_SECONDS=300
LOCAL801_SCANNER_NONCE_TTL_SECONDS=600
LOCAL801_SCANNER_RATE_LIMIT_PER_MINUTE=60
LOCAL801_SCANNER_MAX_CONCURRENT=4
LOCAL801_SCANNER_CLAMD_TIMEOUT_MS=8000
