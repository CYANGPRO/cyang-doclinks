{
  "name": "@cyang/local801-engage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "description": "Private membership, CAT engagement, campaign, reporting, and document hub for MAPE Local 801.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && npm run security:production-preflight:build-report",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.mjs",
    "test:xlsx-scale": "node --conditions=react-server --experimental-strip-types scripts/test-xlsx-scale.mjs",
    "test:sql-integration": "node --conditions=react-server --experimental-strip-types scripts/test-sql-integration.mjs",
    "test:rate-limit-sql": "node scripts/test-rate-limit-sql.mjs",
    "performance:plans": "node --conditions=react-server --experimental-strip-types scripts/measure-dashboard-report-plans.mjs",
    "db:migrations": "npm run db:migrations:verify",
    "db:migrations:verify": "node scripts/verify-migrations.mjs",
    "security": "npm run security:audit && npm run security:production-readiness",
    "security:production-readiness": "node --experimental-strip-types scripts/check-production-readiness.mjs",
    "security:production-preflight": "node --conditions=react-server --experimental-strip-types scripts/check-production-readiness.mjs --preflight",
    "security:production-preflight:build-report": "node --conditions=react-server --experimental-strip-types scripts/check-production-readiness.mjs --preflight --report-only --vercel-production-only",
    "security:secret-scan": "node scripts/check-committed-secrets.mjs",
    "security:route-audit": "node scripts/audit-route-security.mjs",
    "release:gate": "npm run lint && npm run typecheck && npm test && npm run db:migrations:verify && npm run test:xlsx-scale && npm run security:secret-scan && npm run security:route-audit && npm audit --omit=dev && npm run build",
    "security:accept-production-rate-limit": "node scripts/accept-production-rate-limit.mjs",
    "security:accept-malware-scanner": "node --conditions=react-server --experimental-strip-types scripts/accept-malware-scanner.mjs",
    "security:initialize-production": "node --conditions=react-server --experimental-strip-types scripts/initialize-production.mjs",
    "recovery:r2": "node scripts/recover-r2-objects.mjs",
    "recovery:r2:key-read-test": "node --conditions=react-server --experimental-strip-types scripts/test-r2-key-recovery.mjs",
    "security:retention-inventory": "node --conditions=react-server --experimental-strip-types scripts/retention-inventory.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:sbom": "npm sbom --omit=dev --sbom-format=cyclonedx",
    "pii:dual-write:enable:preview": "node --conditions=react-server --experimental-strip-types scripts/enable-pii-dual-write-preview.mjs",
    "pii:backfill:preview": "node --conditions=react-server --experimental-strip-types scripts/backfill-pii-preview-v2.mjs",
    "pii:verify:preview": "node --conditions=react-server --experimental-strip-types scripts/verify-pii-protected-preview.mjs",
    "pii:rotate:protected": "node --conditions=react-server --experimental-strip-types scripts/rotate-protected-pii.mjs",
    "seed:synthetic": "node scripts/seed-synthetic.mjs",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "mobile:sync": "npm run mobile:assets && cap sync",
    "mobile:add:android": "npm run mobile:assets && cap add android",
    "mobile:add:ios": "npm run mobile:assets && cap add ios --packagemanager SPM",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:build:android": "node scripts/check-mobile-release.mjs && cap build android --androidreleasetype AAB",
    "mobile:build:ios": "node scripts/check-mobile-release.mjs && cap build ios --scheme App",
    "mobile:release:gate": "node scripts/check-mobile-release.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@aws-sdk/s3-request-presigner": "^3.1011.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "8.3.0",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "10.70.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "jszip": "3.10.1",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "workflow": "^4.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@napi-rs/canvas": "^0.1.95",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.7",
    "typescript": "^5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@workflow/core@4.8.2": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local@4.2.4": {
      "undici": "7.29.0"
    },
    "@workflow/world-vercel@4.6.2": {
      "undici": "7.29.0"
    }
  }
}
