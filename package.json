    "serialize-javascript": "^7.0.0",
    "flatted": "^3.4.2",
    "tmp": "^0.2.5",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.7",
    "lighthouse": "^12.6.1",
    "playwright": "^1.58.2",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
