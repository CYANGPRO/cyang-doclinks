{
  "name": "cyang-doclinks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0 <25",
    "npm": ">=10.9.2 <12"
  },
  "volta": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "node scripts/run-repo-tool.mjs next dev",
    "build": "node scripts/run-repo-tool.mjs next build",
    "start": "node scripts/run-repo-tool.mjs next start",
    "postinstall": "node scripts/verify-proof-install.mjs",
    "setup:proof:windows": "powershell -ExecutionPolicy Bypass -File scripts/use-proof-runtime.ps1",
    "test:playwright": "node scripts/run-repo-tool.mjs playwright test",
    "test": "node scripts/run-test-suite.mjs",
    "test:live-ish": "node scripts/run-test-suite.mjs --profile=live-ish",
    "test:integration": "node scripts/verify-runtime.mjs",
    "lint": "node scripts/run-repo-tool.mjs eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrations:verify": "node scripts/migrate.mjs verify",
    "audit:admin-routes": "node scripts/audit-admin-route-guards.mjs",
    "audit:admin-polling": "node scripts/audit-admin-polling-targets.mjs",
    "audit:public-rendering": "node scripts/audit-public-rendering.mjs",
    "audit:route-handlers": "node scripts/audit-route-handler-rendering.mjs",
    "audit:polling": "node scripts/audit-polling-discipline.mjs",
    "audit:bundle-budgets": "node scripts/audit-bundle-budgets.mjs",
    "audit:env-example": "node scripts/check-env-example.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "production-readiness": "node scripts/production-readiness.mjs",
    "local801:dev": "npm --prefix apps/local801-engage run dev",
    "local801:build": "npm --prefix apps/local801-engage run build",
    "local801:start": "npm --prefix apps/local801-engage run start",
    "local801:lint": "npm --prefix apps/local801-engage run lint",
    "local801:typecheck": "npm --prefix apps/local801-engage run typecheck",
    "local801:test": "npm --prefix apps/local801-engage run test",
    "local801:db:migrations:verify": "npm --prefix apps/local801-engage run db:migrations:verify",
    "restore:verify": "node scripts/restore-verify.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "runtime:proof:live": "node scripts/live-runtime-proof.mjs",
    "fire-drill:staging": "node scripts/fire-drill-staging.mjs",
    "test:a11y": "npm run test:playwright -- tests/a11y.spec.ts",
    "test:a11y:ci": "node scripts/run-repo-tool.mjs start-server-and-test \"npm run start\" http://127.0.0.1:3000 \"npm run test:a11y\"",
    "test:attack": "npm run test:playwright -- tests/attack-sim.spec.ts",
    "test:attack:ci": "node scripts/run-repo-tool.mjs start-server-and-test \"npm run start\" http://127.0.0.1:3000 \"npm run test:attack\"",
    "test:billing:webhook": "npm run test:playwright -- tests/billing-webhook.spec.ts",
    "test:billing:webhook:ci": "node scripts/run-repo-tool.mjs start-server-and-test \"npm run start\" http://127.0.0.1:3000 \"npm run test:billing:webhook\"",
    "test:security:state": "npm run test:playwright -- tests/security-state.spec.ts",
    "test:security:state:ci": "node scripts/run-repo-tool.mjs start-server-and-test \"npm run start\" http://127.0.0.1:3000 \"npm run test:security:state\"",
    "test:security:freeze": "npm run test:playwright -- tests/security-freeze.spec.ts",
    "test:security:freeze:ci": "node scripts/run-repo-tool.mjs start-server-and-test \"npm run start\" http://127.0.0.1:3000 \"npm run test:security:freeze\"",
    "audit:lighthouse": "node scripts/run-lhci.mjs",
    "audit:browser": "npm run test:a11y:ci",
    "audit:browser:ci": "npm run test:a11y:ci && npm run audit:lighthouse",
    "prove:build": "node scripts/prove-build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@aws-sdk/s3-request-presigner": "^3.1011.0",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^10.44.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "next": "^16.1.7",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "openid-client": "^6.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.4",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@aws-sdk/xml-builder": "^3.972.15",
