# syntax=docker/dockerfile:1.7

FROM node:22.16.0-bookworm AS proof

ENV CI=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    PROOF_PLAYWRIGHT_INSTALL_WITH_DEPS=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
COPY scripts/verify-proof-install.mjs ./scripts/verify-proof-install.mjs
COPY scripts/lib/proof-install.mjs ./scripts/lib/proof-install.mjs
COPY scripts/lib/repo-tooling.mjs ./scripts/lib/repo-tooling.mjs
RUN npm ci

COPY . .

RUN npm run prove:build
